  // src/services/organizationservices/organization.service.ts
  var getStoredOrganizationId = () => {
    if (typeof window === "undefined") return null;
    return localStorage.getItem("cocoper_org_id");
  };
  var storeOrganizationId = (id3) => {
    if (typeof window === "undefined") return;
    localStorage.setItem("cocoper_org_id", id3);
  };
  async function getOrganizations() {
    const response = await fetch(`${API}/organizations`);
    if (!response.ok) {
      throw await response.json().catch(() => ({ message: "Failed to load organizations" }));
    }
    return response.json();
  }
  async function getCurrentOrganization(organizationId) {
    const headers = {};
    const resolvedId = organizationId ?? getStoredOrganizationId();
    if (resolvedId) {
      headers["x-organization-id"] = resolvedId;
    }
    const response = await fetch(`${API}/organizations/me`, { headers });
    if (!response.ok) {
      throw await response.json().catch(() => ({ message: "Failed to load organization" }));
    }
    return response.json();
  }
  async function updateOrganization(id3, payload) {
    const response = await fetch(`${API}/organizations/${id3}`, {
      method: "PUT",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) {
      throw data2;
    }
    return data2;
  }
  async function getOrganizationDocuments(organizationId) {
    const response = await fetch(`${API}/organizations/${organizationId}/documents`);
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to load documents" }));
    return response.json();
  }
  async function getOrganizationDocument(organizationId, docType) {
    const response = await fetch(`${API}/organizations/${organizationId}/documents/${docType}`);
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to load document" }));
    return response.json();
  }
  async function uploadOrganizationDocument(organizationId, docType, payload) {
    const response = await fetch(`${API}/organizations/${organizationId}/documents/${docType}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }
  async function deleteOrganizationDocument(organizationId, docType) {
    const response = await fetch(`${API}/organizations/${organizationId}/documents/${docType}`, {
      method: "DELETE"
    });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to delete document" }));
  }

  // src/services/branchesservices/branches.service.ts
  async function getBranches() {
    const response = await fetch(`${API}/branches`, { headers: getOrgHeader() });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to load branches" }));
    return response.json();
  }
  async function getNextBranchCode() {
    const response = await fetch(`${API}/branches/next-code`, { headers: getOrgHeader() });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to generate branch code" }));
    const data2 = await response.json();
    return data2.code;
  }
  async function createBranch(payload) {
    const response = await fetch(`${API}/branches`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...getOrgHeader() },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }
  async function updateBranch(id3, payload) {
    const response = await fetch(`${API}/branches/${id3}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }
  async function deleteBranch(id3) {
    const response = await fetch(`${API}/branches/${id3}`, { method: "DELETE" });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to delete branch" }));
  }
  async function getUserBranches(userId) {
    const response = await fetch(`${API}/branches/user-branches/${userId}`, {
      headers: getOrgHeader()
    });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to load user branches" }));
    return response.json();
  }
  async function setUserBranches(userId, payload) {
    const response = await fetch(`${API}/branches/user-branches/${userId}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json", ...getOrgHeader() },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }

  // src/utils/scopeEvents.ts
  var SCOPE_CHANGE_EVENT = "cocoper-scope-change";
  function notifyScopeChange() {
    if (typeof window === "undefined") return;
    window.dispatchEvent(new Event(SCOPE_CHANGE_EVENT));
  }
  function onScopeChange(callback) {
    if (typeof window === "undefined") return () => {
