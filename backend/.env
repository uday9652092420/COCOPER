# ================================================================
#  COCONUT COCKTAIL ERP - BACKEND ENVIRONMENT CONFIGURATION
# ----------------------------------------------------------------
#  RELEASE WORKFLOW:
#   1. Keep ONLY the block for your target environment uncommented
#      (LOCAL / TESTING / LIVE).
#   2. Run:  cd backend && npm run build
#   3. Deploy & start:  node dist/server.js   (or pm2, see
#      ecosystem.config.js).
#  Do NOT leave more than one database block active at a time.
# ================================================================

# ================================================================
#  [A] LOCAL ENVIRONMENT (Development)  --- comment to deactivate
# ================================================================
NODE_ENV=development
PORT=4004

DB_HOST=localhost
DB_PORT=5432
DB_NAME=CoconutCocktailDB
DB_USER=postgres
DB_PASSWORD=NewPassword@123
DATABASE_URL=postgresql://postgres:NewPassword@123@localhost:5432/CoconutCocktailDB

API_BASE_URL=http://localhost:4004
FRONTEND_URL=http://localhost:8000

# ================================================================
#  [B] TESTING SERVER (R & D)
# ================================================================
# NODE_ENV=production
# PORT=3003

# DB_HOST=192.168.1.230
# DB_PORT=5432
# DB_NAME=CoconutCocktailDB
# DB_USER=postgres
# DB_PASSWORD=sa@123
# DATABASE_URL=postgresql://postgres:sa@123@192.168.1.230:5432/CoconutCocktailDB

# API_BASE_URL=http://192.168.1.230:3003
# FRONTEND_URL=http://192.168.1.230:92

# ================================================================
#  [C] LIVE / PRODUCTION SERVER  --- ACTIVE
# ================================================================
# NODE_ENV=production
# PORT=3005

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=CoconutCocktailDB
# DB_USER=postgres
# DB_PASSWORD=StrongPassword@123
# DATABASE_URL=postgresql://postgres:StrongPassword@123@localhost:5432/CoconutCocktailDB

# API_BASE_URL=http://109.199.106.107:3005
# FRONTEND_URL=http://109.199.106.107

# ================================================================
#  Security (shared / global - keep outside the blocks above)
# ================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ================================================================
#  Logging
# ================================================================
LOG_LEVEL=debug

