# ================================================================
#  COCONUT COCKTAIL ERP - BACKEND ENVIRONMENT CONFIGURATION
#  (template - copy to .env and fill in the block you need)
# ================================================================

# [A] LOCAL ENVIRONMENT (Development)
NODE_ENV=development
PORT=4004

DB_HOST=localhost
DB_PORT=5432
DB_NAME=CoconutCocktailDB
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/CoconutCocktailDB

API_BASE_URL=http://localhost:4004
FRONTEND_URL=http://localhost:8000

# [B] TESTING SERVER (R & D)  --- uncomment to activate
# NODE_ENV=production
# PORT=3003
# DB_HOST=192.168.1.230
# DB_PORT=5432
# DB_NAME=CoconutCocktailDB
# DB_USER=postgres
# DB_PASSWORD=change-me
# DATABASE_URL=postgresql://postgres:change-me@192.168.1.230:5432/CoconutCocktailDB
# API_BASE_URL=http://192.168.1.230:3003
# FRONTEND_URL=http://192.168.1.230

# [C] LIVE / PRODUCTION SERVER  --- uncomment & fill in to activate
# NODE_ENV=production
# PORT=3005
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=CoconutCocktailDB
# DB_USER=postgres
# DB_PASSWORD=StrongPassword@123
# DATABASE_URL=DATABASE_URL=postgresql://postgres:StrongPassword@123@localhost:5432/CoconutCocktailDB
# API_BASE_URL=http://109.199.106.107:3005
# FRONTEND_URL=http://109.199.106.107

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Logging
LOG_LEVEL=debug
