  <table>
    <thead>
      <tr>
        <th style="width:32px">#</th>
        <th>Item</th>
        <th class="right">Qty</th>
        <th class="right">Discount</th>
        <th class="right">Actual Qty</th>
        <th class="right">Purchase Cost</th>
        <th class="right">Purchase Amount</th>
      </tr>
    </thead>
    <tbody>${de}</tbody>
    <tfoot>
