/**
 * @file README.md
 * @description Documentation for the mock Bag Purchase API.
 *
 * Usage:
 *  import * as BagPurchaseAPI from 'src/api/bagPurchase/handlers'
 *
 *  const list = await BagPurchaseAPI.list()
 *  const one = await BagPurchaseAPI.getById(id)
 *  const created = await BagPurchaseAPI.add(payload)
 *  const updated = await BagPurchaseAPI.edit(id, payload)
 *  await BagPurchaseAPI.remove(id)
 *
 * Notes:
 * - This mock API persists data to localStorage under key 'wc_bag_purchases_v1'.
 * - Designed for frontend development and can be swapped with real backend handlers later.
 */