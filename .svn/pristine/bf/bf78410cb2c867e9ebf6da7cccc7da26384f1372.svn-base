  async function registerOrganization(payload) {
    const response = await fetch(
      `${API}/auth/register`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(payload)
      }
    );
    const data2 = await response.json().catch(() => null);
    if (!response.ok) {
      const error = new Error(
        data2?.message || "Unable to register organization."
      );
      error.status = response.status;
      error.details = data2?.details;
      throw error;
    }
    return data2;
  }

