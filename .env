# ================================================================
#  COCONUT COCKTAIL ERP - FRONTEND ENVIRONMENT CONFIGURATION
# ----------------------------------------------------------------
#  VITE_BASE_API_URL is injected into the bundle at build time by
#  scripts/build.mjs (as import.meta.env.VITE_BASE_API_URL) and is
#  read by src/config/api.ts (used by src/services/*).
#
#  RELEASE WORKFLOW:
#   1. Keep ONLY the block for your target environment uncommented.
#   2. Run:  npm run build   (or  npm run dev  for local dev).
#   3. Deploy the dist/ folder to that server.
#
#  WARNING: do NOT leave the LOCAL line active when building a
#  TESTING / LIVE release, or the app will call localhost:4004.
# ================================================================

# ================================================================
#  [A] LOCAL ENVIRONMENT (Development)  --- comment to deactivate
# ================================================================
VITE_BASE_API_URL=http://localhost:4004/api

# ================================================================
#  [B] TESTING SERVER (R & D)  --- ACTIVE
# ================================================================
# VITE_BASE_API_URL=http://192.168.1.230:3003/api

# ================================================================
#  [C] LIVE / PRODUCTION SERVER  --- uncomment & fill in to activate
# ================================================================
# VITE_BASE_API_URL=http://<live-server-ip>:3000/api
