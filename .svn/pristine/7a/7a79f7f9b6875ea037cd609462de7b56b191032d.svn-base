    th { background: #f3f4f6; }
    .right { text-align: right; }
    .total { font-weight: bold; font-size: 14px; }
    .sign { margin-top: 40px; display: flex; justify-content: space-between; }
  </style>
</head>
<body>
  <div class="head">
    <div>
      <h1>Sales Invoice</h1>
      <div class="muted">Invoice No: ${me.directSaleNo??me.id}</div>
      <div class="muted">Date: ${wt(me.invoiceDate)}</div>
    </div>
    <div class="info muted" style="text-align:right">
      <div>Customer: <b>${ze?.name??"-"}</b></div>
      <div>Address: ${Tt||"-"}</div>
      <div>Branch: ${Ke}</div>
    </div>
  </div>
  <table>
    <thead>
      <tr>
        <th style="width:32px">#</th>
        <th>Item</th>
        <th class="right">Qty</th>
        <th class="right">Discount</th>
        <th class="right">Actual Qty</th>
        <th class="right">Sales Price</th>
        <th class="right">Sales Amount</th>
      </tr>
    </thead>
    <tbody>${ve}</tbody>
    <tfoot>
      <tr>
        <td colspan="6" class="right">Total Sales Lines Amount</td>
        <td class="right total">${et(qe)}</td>
      </tr>
      <tr>
        <td colspan="6" class="right">Gunny Bags Line Amount</td>
        <td class="right">${et(Ze)}</td>
      </tr>
      <tr>
        <td colspan="6" class="right">Other Charges</td>
        <td class="right">${et(Ye)}</td>
      </tr>
      <tr>
        <td colspan="6" class="right">Invoice Total</td>
        <td class="right total">${et(q)}</td>
      </tr>
    </tfoot>
  </table>
  <div class="sign">
    <div>Prepared By: ______________________</div>
    <div>Authorized Signature: ______________________</div>
  </div>
</body>
</html>`),Pe.document.close(),Pe.focus(),setTimeout(()=>Pe.print(),300)};return(0,fe.jsxs)("div",{children:[(0,fe.jsx)(Qe,{title:"Direct Sales",breadcrumb:["Transactions","Direct Sales"]}),(0,fe.jsx)(ht,{onAddNew:r?Le:void 0,onExportExcel:o?z:void 0,onExportPdf:o?()=>ge(!0):void 0,onPrint:o?()=>ge(!1):void 0,onRefresh:()=>{_(),F.success("Direct sales list refreshed.")}}),(0,fe.jsx)(Ot,{onSearchChange:I,searchPlaceholder:"Search by customer, branch, direct sale no..."}),(0,fe.jsx)(Sn,{data:Z,columns:ee,getRowId:me=>me.id,loading:v}),(0,fe.jsx)(Qr,{currentPage:he,totalPages:se,onPageChange:E}),(0,fe.jsx)(LPe,{open:X,existing:M??j,viewOnly:!!j,onClose:()=>{T(!1),R(null),C(null)},onSave:r||a?ce:async()=>{},onApprove:n?async me=>{await Ae(me),T(!1),R(null),C(null)}:void 0,onPrint:o?me=>Me(me):void 0,customers:c,branches:g,items:b,salesOrders:m,gunnyBags:w,generateDirectSaleNo:te}),(0,fe.jsx)(kPe,{open:k,amount:O,onConfirm:()=>{A(!1),F.success("Receipt collection confirmed.")},onCancel:()=>{A(!1),F.warning("Receipt not collected for Red customer. Please ensure cash collection.")}}),(0,fe.jsx)(Kr,{open:!!N,title:"Delete direct sales?",description:N?`Are you sure you want to delete invoice dated ${wt(N.invoiceDate)}? This cannot be undone.`:"",confirmLabel:"Delete",cancelLabel:"Cancel",onConfirm:pe,onCancel:()=>L(null)})]})},gW=APe;var ja=G(Ie());var Ge=G(Ne()),TPe=({open:e,existing:t,onClose:r,onSave:a})=>{let[n,o]=(0,ja.useState)({supplierId:"",itemId:"",quantity:0,purchaseCost:0}),[i,s]=(0,ja.useState)({customerId:"",salesPrice:0}),[l,u]=(0,ja.useState)(!1);(0,ja.useEffect)(()=>{t?(o({supplierId:t.supplierId,itemId:t.itemId??"",quantity:t.quantity,purchaseCost:t.purchaseRate}),s({customerId:t.customerId,salesPrice:t.salesRate})):(o({supplierId:"",itemId:"",quantity:0,purchaseCost:0}),s({customerId:"",salesPrice:0}),u(!1))},[t,e]);let d=(0,ja.useMemo)(()=>{let y=Number(n.quantity)||0,m=Number(n.purchaseCost)||0;return Number((y*m).toFixed(2))},[n.quantity,n.purchaseCost])