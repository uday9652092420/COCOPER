      method: "POST",
      headers: { "Content-Type": "application/json", ...getOrgHeader() },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }
  async function updateRole(id3, payload) {
    const response = await fetch(`${API}/roles/${id3}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }
  async function deleteRole(id3) {
    const response = await fetch(`${API}/roles/${id3}`, { method: "DELETE" });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to delete role" }));
  }

