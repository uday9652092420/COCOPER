/**
 * @file gunny_bag_master.sql
 * @description PostgreSQL script to create the gunny_bags master table, supporting enum status
 *              and seeding sample rows for the GunnyBagMasterPage.
 *
 * Notes:
 * - Intended for PostgreSQL (psql).
 * - Creates enum type gunny_bag_status and table gunny_bags with helpful indexes.
 */

BEGIN;

-- Create an enum type for gunny bag status
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'gunny_bag_status') THEN
    CREATE TYPE gunny_bag_status AS ENUM ('Active', 'Inactive');
  END IF;
END$$;

-- Create gunny_bags table
CREATE TABLE IF NOT EXISTS gunny_bags (
  id TEXT PRIMARY KEY,
  code TEXT NOT NULL UNIQUE,
  name TEXT NOT NULL,
  size TEXT,
  rate_per_bag NUMERIC DEFAULT 0,
  opening_stock INTEGER DEFAULT 0,
  status gunny_bag_status DEFAULT 'Active',
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  created_at DATE DEFAULT CURRENT_DATE
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_gunny_bags_code ON gunny_bags(code);
CREATE INDEX IF NOT EXISTS idx_gunny_bags_name ON gunny_bags(name);
CREATE INDEX IF NOT EXISTS idx_gunny_bags_organization ON gunny_bags(organization_id);

-- Sample data
INSERT INTO gunny_bags (id, code, name, size, rate_per_bag, opening_stock, status, created_at) VALUES
('GB1', 'GB-001', 'Jute Bag', '25x40 cm', 45, 100, 'Active', CURRENT_DATE - INTERVAL '30 days')
ON CONFLICT (id) DO NOTHING;

INSERT INTO gunny_bags (id, code, name, size, rate_per_bag, opening_stock, status, created_at) VALUES
('GB2', 'GB-002', 'Inner Bag', '30x50 cm', 60, 50, 'Active', CURRENT_DATE - INTERVAL '20 days')
ON CONFLICT (id) DO NOTHING;

INSERT INTO gunny_bags (id, code, name, size, rate_per_bag, opening_stock, status, created_at) VALUES
('GB3', 'GB-003', 'Poly Liner', '20x30 cm', 30, 200, 'Active', CURRENT_DATE - INTERVAL '10 days')
ON CONFLICT (id) DO NOTHING;

COMMIT;