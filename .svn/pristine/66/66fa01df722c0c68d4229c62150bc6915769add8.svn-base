        <td colspan="6" class="right">Total Lines Amount</td>
        <td class="right total">${et(q)}</td>
      </tr>
    </tfoot>
  </table>
  <div class="sign">
    <div>Prepared By: ______________________</div>
    <div>Authorized Signature: ______________________</div>
  </div>
</body>
</html>`),D.document.close(),D.focus(),setTimeout(()=>D.print(),300)},z=Y=>{let D=window.open("","_blank","width=900,height=700");if(!D){B.error("Popup blocked. Please allow popups and try again.");return}let de=O.find(ye=>ye.id===Y.customerId),q=de?.name??"-",ne=[de?.address,de?.state].filter(Boolean).join(", "),ve=Y.lines.map((ye,Be)=>{let tt=k.find(lt=>lt.id===ye.itemId)?.name??ye.itemId;return`<tr>
