  async function getProfile(userId, userType) {
    const response = await fetch(`${API}/profile/me`, {
      headers: getUserHeaders(userId, userType)
    });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to load profile" }));
    return response.json();
  }
  async function updateProfile(userId, userType, payload) {
    const response = await fetch(`${API}/profile/me`, {
      method: "PUT",
      headers: {
        "Content-Type": "application/json",
        ...getUserHeaders(userId, userType)
      },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
    return data2;
  }
  async function changePassword(userId, userType, oldPassword, newPassword) {
    const response = await fetch(`${API}/profile/password`, {
      method: "PUT",
      headers: {
        "Content-Type": "application/json",
        ...getUserHeaders(userId, userType)
      },
      body: JSON.stringify({ old_password: oldPassword, new_password: newPassword })
    });
    const data2 = await response.json();
    if (!response.ok) throw data2;
  }

