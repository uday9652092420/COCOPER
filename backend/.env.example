# ================================================================
#  COCONUT COCKTAIL ERP - BACKEND ENVIRONMENT CONFIGURATION
#  (template - copy to .env and fill in the block you need)
# ================================================================

# # [A] LOCAL ENVIRONMENT (Development)
# NODE_ENV=development
# PORT=4004

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=CoconutCocktailDB
# DB_USER=postgres
# DB_PASSWORD=change-me
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/CoconutCocktailDB

# API_BASE_URL=http://localhost:4004
# FRONTEND_URL=http://localhost:8000

[B] TESTING SERVER (R & D)  --- uncomment to activate
NODE_ENV=production
PORT=3003
DB_HOST=192.168.1.230
DB_PORT=5432
DB_NAME=CoconutCocktailDB
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@192.168.1.230:5432/CoconutCocktailDB
API_BASE_URL=http://192.168.1.230:3003
FRONTEND_URL=http://192.168.1.230

# [C] LIVE / PRODUCTION SERVER  --- uncomment & fill in to activate
# NODE_ENV=production
# PORT=3000
# DB_HOST=<live-db-host>
# DB_PORT=5432
# DB_NAME=CoconutCocktailDB
# DB_USER=<live-db-user>
# DB_PASSWORD=<live-db-password>
# DATABASE_URL=postgresql://<live-db-user>:<live-db-password>@<live-db-host>:5432/CoconutCocktailDB
# API_BASE_URL=http://<live-server-ip>:3000
# FRONTEND_URL=http://<live-server-ip>

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Logging
LOG_LEVEL=debug
