      method: "PUT",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });
    const data2 = await response.json();
    if (!response.ok) {
      throw data2;
    }
    return data2;
  }
  async function deleteItem(id3) {
    const response = await fetch(`${API}/items/${id3}`, {
      method: "DELETE"
    });
    const data2 = await response.json();
    if (!response.ok) {
      throw data2;
    }
    return data2;
  }
  async function getItemBranchStock(itemId) {
    const response = await fetch(`${API}/items/${itemId}/stock`, { headers: getOrgHeader() });
    if (!response.ok) throw await response.json().catch(() => ({ message: "Failed to load item branch stock" }));
    return response.json();
  }
